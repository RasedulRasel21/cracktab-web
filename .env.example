# ---------------------------------------------------------------- database
# cracktab_web on the shared cracktab-db droplet. Two URLs, on purpose:
#
#   DATABASE_URL  6432 — PgBouncer (transaction mode). Application queries.
#   DIRECT_URL    5432 — Postgres directly. Migrations and introspection only,
#                        because Migrate needs a session-level connection.
#
# sslmode=verify-full, not require: `require` encrypts but validates nothing,
# and these ports accept connections from anywhere. db.cracktab.com has a real
# Let's Encrypt certificate, so verification costs nothing and stops an active
# man-in-the-middle.
DATABASE_URL="postgresql://cracktab_web:PASSWORD@db.cracktab.com:6432/cracktab_web?sslmode=verify-full"
DIRECT_URL="postgresql://cracktab_web:PASSWORD@db.cracktab.com:5432/cracktab_web?sslmode=verify-full"

# ---------------------------------------------------------------- auth
# openssl rand -base64 32
AUTH_SECRET=""

# ---------------------------------------------------------------- email
# Existing contact-form transport (app/contact/actions.ts).
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
CONTACT_TO=""
CONTACT_FROM=""

# Google Tag Manager container ID. Leave empty to load no GTM at all.
NEXT_PUBLIC_GTM_ID=""
